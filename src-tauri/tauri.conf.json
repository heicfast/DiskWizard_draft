{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiskWizard",
  "version": "0.1.0",
  "identifier": "app.diskwizard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DiskWizard",
        "width": 1440,
        "height": 880,
        "minWidth": 1180,
        "minHeight": 760,
        "maximized": true,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "visible": false,
        "backgroundColor": "#fbf1ee",
        "center": true,
        "titleBarStyle": "Overlay",
        "additionalBrowserArgs": "--enable-features=OverlayScrollbar,FluentOverlayScrollbar"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost; frame-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msix"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 DiskWizard",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
