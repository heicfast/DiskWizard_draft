{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window: the dialog plugin plus the window-control surface (drag, caption verbs, set-size/set-fullscreen/center — the CI tour's responsive steps drive the same core verbs any window-layout feature would).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-maximize",
    "core:window:allow-show",
    "core:window:allow-set-size",
    "core:window:allow-set-fullscreen",
    "core:window:allow-center",
    "core:window:allow-set-focus",
    "core:event:default"
  ]
}
